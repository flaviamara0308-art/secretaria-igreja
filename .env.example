# GEMINI_API_KEY: Required only if Gemini AI API calls are enabled on server-side routes.
# Configure via environment variables in Netlify / AI Studio UI (never commit real secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this app is hosted (e.g. https://sua-igreja.netlify.app).
APP_URL="MY_APP_URL"

# Firebase Web Config (Note: firebase-applet-config.json is already bundled for client initialization;
# if deploying separately with custom Firebase credentials on Netlify, define VITE_FIREBASE_* vars)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""

